# ============================================================================
# xhs-agent · 后端环境变量（模板）
#
# 用法：复制为 backend/.env 后按需修改：
#     copy .env.example .env        （Windows cmd）
#     Copy-Item .env.example .env   （PowerShell）
#
# .env 已被根 .gitignore 忽略；本文件只含占位符，可安全入库。
# ============================================================================

# --- 基础 ---
APP_ENV=local
APP_NAME=xhs-agent-backend
APP_VERSION=0.1.0

# --- PostgreSQL（与根 .env 的 compose 配置保持一致）---
# 主机用 127.0.0.1 而非 localhost：避免 Windows 上 localhost 双栈（IPv6→IPv4）
# 各超时一次；docker-compose 端口也只绑定 127.0.0.1，两者一致。
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/xhs_agent
# 连接超时（秒）：数据库不可达时，保证健康探针在有限时间内返回而非挂起
DB_CONNECT_TIMEOUT=3

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0
# 连接 / 读写超时（秒）
REDIS_CONNECT_TIMEOUT=3

# --- CORS（多个来源用英文逗号分隔）---
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# 大模型（DeepSeek，OpenAI 兼容）
#
# 模型 ID 一律使用占位符，请以 DeepSeek 控制台当前列表为准：
#   https://api-docs.deepseek.com/zh-cn/quick_start/pricing
# 真实密钥只填在本地 .env，切勿提交到仓库或粘贴到任何在线文档。
#
# ⚠️ 在填入真实 LLM_API_KEY 之前，请保持 AGENT_LLM_ENABLED=false：
#    届时除显式的真实检查脚本（scripts/check_llm_harness.py）外，
#    任何入口都不会发起对外 LLM 网络调用。
# ---------------------------------------------------------------------------
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=把这里替换成DeepSeek控制台当前模型名

# --- Agent Harness（LangChain / LangGraph 基座）---
# 总开关：无 key 或设为 false 时，不发起任何真实 LLM 请求（除显式真实检查脚本外）
AGENT_LLM_ENABLED=false
# LangGraph 递归上限（新版默认 1000，这里显式收窄以便可预期）
AGENT_RECURSION_LIMIT=40
# 单个 LLM 节点最大重试次数（仅 429/5xx/网络异常/JSON 解析失败这类可重试错误）
AGENT_NODE_MAX_RETRIES=2
# 结构化输出（JSON）最多尝试次数
AGENT_JSON_MAX_ATTEMPTS=3
# 单节点墙钟超时（秒）
AGENT_NODE_TIMEOUT_SECONDS=60
# 检查点后端：postgres（默认）/ memory（仅离线自测）
AGENT_CHECKPOINTER=postgres

# LangSmith（可选 SaaS 观测平台）：默认关闭。
# 开启意味着会把运行轨迹【外发到第三方】，并可能产生费用，由使用者自行评估与承担。
AGENT_LANGSMITH_TRACING=false
AGENT_LANGSMITH_API_KEY=
AGENT_LANGSMITH_PROJECT=xhs-agent

# ---------------------------------------------------------------------------
# 热搜采集（第 9 步 · 经 DailyHotApi 采集公开榜单）
#
# 【合规红线】只采公开榜单；不请求任何小红书域名、不写登录态 / Cookie。
#   小红书（xhs）无 DailyHotApi 路由且公开热搜需登录态 —— 一律禁用。
#
# 第 1 步实测结论（2026-10-09，本地 dailyhot-api 2.0.8）：
#   成功 key ：zhihu / douyin / bilibili / toutiao / qq-news
#   错误 key ：bili / newsqq（正确写法为 bilibili / qq-news，写错会 404）
#   默认禁用 ：weibo（上游曾持续 500）、baidu（曾返回无 title 脏数据）、xhs（合规）
#
# 第 23 步实测补充（2026-10-15）：本地镜像 /all 共 56 路由，含 github
#   （GitHub 趋势日榜，来源 github.com/trending；只读公开榜单，无登录态）——已同级启用。
# ---------------------------------------------------------------------------
# DailyHotApi 服务地址（docker compose 的 dailyhot 服务，仅绑 127.0.0.1）
HOTSPOT_API_BASE_URL=http://127.0.0.1:6688
# 启用的源标识，英文逗号分隔（不得包含小红书 xhs / xiaohongshu）
HOTSPOT_ENABLED_SOURCES=zhihu,douyin,bilibili,toutiao,qq-news,github
# 每源最多保留条数
HOTSPOT_PER_SOURCE_LIMIT=20
# 是否强行绕过上游缓存（默认 false，尊重上游约 60 分钟缓存）
HOTSPOT_FORCE_REFRESH=false
# false：raw_extra 仅保留 id / mobileUrl / timestamp，cover_url / summary / author 留 NULL
HOTSPOT_KEEP_EXTRA_FIELDS=false
# 单请求超时（秒）
HOTSPOT_TIMEOUT_SECONDS=10
# 单源最多尝试次数（仅 429 / 5xx / 网络异常重试；4xx 立即失败）
HOTSPOT_MAX_ATTEMPTS=3
# 定时采集：开关 / 间隔（分钟）/ 启动时是否立刻抓一次
HOTSPOT_SCHEDULER_ENABLED=true
HOTSPOT_FETCH_INTERVAL_MINUTES=60
HOTSPOT_FETCH_ON_STARTUP=false

# ---------------------------------------------------------------------------
# 关键词搜索（第 23 步 · GitHub 仓库搜索，官方 api.github.com / 只读公开数据）
#
# 【红线】只接「公开、免登录、有官方 / 稳定接口」的源；本期只注册 github。
#   不请求任何内容平台（小红书 / 抖音 / 微博 / 知乎等）搜索域名，
#   不使用任何登录态 / Cookie / 账号。
# 【GITHUB_TOKEN（可选）】留空 = 匿名搜索（限速约 10 次/分钟）；填写后提升
#   （约 30 次/分钟）——一律以响应头 X-RateLimit-* 为准动态退让，不硬刷。
#   获取路径：https://github.com/settings/tokens （只读公开数据无需勾选任何 scope）
#   真实 token 只填在本地 .env，绝不入代码 / 日志 / 响应 / 前端产物。
# 【代理】GITHUB_API_BASE 为外网地址时读 HTTPS_PROXY（国内访问用）；
#   localhost / 127.0.0.1 绝不走代理（自建镜像 / 反代场景）。
# ---------------------------------------------------------------------------
# GitHub token（占位：真实值请只填在本地 .env，切勿提交）
# GITHUB_TOKEN=
# GitHub API 基址（默认官方；国内可按需改为镜像 / 反代地址）
# GITHUB_API_BASE=https://api.github.com
# 搜索缓存 TTL（秒；默认 30 分钟，尊重上游限额）
# SEARCH_CACHE_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# 选题 Agent（第 10 步 · LangGraph 业务图：单热点 → K 个选题）
#
# 走 harness 的 get_chat_model(want_json=True)（OpenAI 兼容，指向 DeepSeek）。
# 真实调用受 AGENT_LLM_ENABLED / LLM_API_KEY 闸门约束：未开启时不发起任何对外请求。
# 离线自检（scripts/selftest_topic_agent.py）注入假模型，无需 key。
# 成本只存 token，不内置价格；Key 只填在本地 .env，绝不入代码 / 日志 / agent_runs。
# ---------------------------------------------------------------------------
# 提示词版本（写入 topics.meta.prompt_version，便于回溯）
TOPIC_PROMPT_VERSION=v1
# 单热点默认生成 / 落库的选题条数
TOPIC_DEFAULT_PER_HOTSPOT=3
# 未显式指定 hotspot_ids 时默认取的热点个数
TOPIC_DEFAULT_HOTSPOT_LIMIT=3
# 单次请求最多处理的热点个数（硬上限）
TOPIC_MAX_HOTSPOTS_PER_REQUEST=10
# 批量并发度；默认 1 = 串行（不引入多线程 / asyncio）
TOPIC_CONCURRENCY=1
# 标题最大长度
TOPIC_TITLE_MAX_LEN=20
# 话题标签个数区间（纯词，不含 #）
TOPIC_MIN_TAGS=3
TOPIC_MAX_TAGS=8
# 内容大纲条数区间
TOPIC_MIN_OUTLINE=3
TOPIC_MAX_OUTLINE=6

# ---------------------------------------------------------------------------
# 内容创作 Agent（第 12 步 · LangGraph 业务图：单选题 → 一篇笔记草稿 + 违禁词合规自检）
#
# 同样走 harness 的 get_chat_model（OpenAI 兼容，指向 DeepSeek），
# 受与上方相同的 AGENT_LLM_ENABLED / LLM_API_KEY 闸门约束：未开启时不发起任何对外请求。
# 模型名请以 DeepSeek 控制台当前模型列表为准（获取路径见上方「大模型」段说明），
# 本文件**不写**模型 ID 实值、不写任何真实密钥。
# 违禁词「基础风险词表」内置在代码里（app/agent/content/forbidden_words.py）：
# 不通过 env 配置、不写入日志；第 19 步接入知识库后统一管理。
# ---------------------------------------------------------------------------
# 提示词版本（写入 notes.llm_meta.prompt_version，便于回溯）
CONTENT_PROMPT_VERSION=v1
# 标题最大长度（超出即判字段硬伤；与 notes.title 的 String(100) 对齐）
NOTE_TITLE_MAX_LEN=100
# 正文长度下限（低于即判字段硬伤）
NOTE_BODY_MIN_LEN=200
# 正文目标长度上限（写入提示词作为写作目标；不作为字段闸门，口径见 docs/agent_content.md）
NOTE_BODY_MAX_LEN=1000
# 话题标签个数区间（纯词，不含 #）
NOTE_MIN_TAGS=3
NOTE_MAX_TAGS=10

# ---------------------------------------------------------------------------
# 多版本创作 Agent（第 23 步 · V2 增强（二）· LangGraph 第七张业务图：单选题 → N 个可对比版本）
#
# 与内容创作共用同一套模型闸门与 NOTE_* 阈值；N（1~5、默认 3）与角度池
# （实用干货 / 情绪共鸣 / 反差观点 / 亲身经历 / 清单盘点 / 避坑提醒）内置在代码里，
# **不通过 env 配置**；多版本元数据存 notes.llm_meta（零迁移）。见 docs/content_variants.md。
# ---------------------------------------------------------------------------
# 提示词版本（写入 notes.llm_meta.prompt_version，便于回溯）
CONTENT_VARIANTS_PROMPT_VERSION=v1

# ---------------------------------------------------------------------------
# 数据回填（第 15 步 · 截图上传 → 视觉识别 → 人工核对后落库）
#
# 走 harness 的 get_chat_model(want_vision=True)（OpenAI 兼容，指向 DeepSeek）。
# 真实调用受 AGENT_LLM_ENABLED / LLM_API_KEY 闸门约束：未开启时不发起任何对外请求。
# 离线自检（scripts/selftest_metrics.py）注入假模型，无需 key；
# 真实视觉检查用 scripts/check_metric_vision.py（未配置时退出码 2、零请求）。
# 成本只存 token、不内置价格；截图由用户本人上传、仅本机流转。
# ---------------------------------------------------------------------------
# 提示词版本（写入识别 evidence 与 agent_runs，便于回溯）
METRIC_PROMPT_VERSION=v1
# 【视觉模型名】请在 DeepSeek 控制台的模型列表复制【支持图片输入】的模型名
#（当前为 deepseek-flash，以控制台为准；获取路径见上方「大模型」段）；
# 留空则回退使用同一段的 LLM_MODEL。
LLM_VISION_MODEL=
# 是否允许把截图留档到服务端（默认 false = 不写任何文件，screenshot_path 恒 NULL）；
# 设为 true 后，仍需在前端识别请求里显式确认（表单 save_screenshot=true）才落盘，
# 文件名由服务端受控生成（note_metrics.screenshot_path 只存相对文件名）。
SAVE_SCREENSHOT=false
# 截图留档目录（相对 backend/；已在根 .gitignore 中忽略）
SCREENSHOT_DIR=data/screenshots
# 单张图片大小上限（字节；默认 4 MB）
METRIC_MAX_IMAGE_BYTES=4194304
# 允许的图片类型（仅这三类；MIME 与文件头魔数都会校验）
METRIC_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ---------------------------------------------------------------------------
# 单篇诊断（第 16 步 · 单篇笔记 → 一次诊断结论，只读 + 建议）
#
# 走 harness 的 get_chat_model(want_json=True)（OpenAI 兼容，指向 DeepSeek，温度 0.2）。
# 真实调用受 AGENT_LLM_ENABLED / LLM_API_KEY 闸门约束：未开启时不发起任何对外请求。
# 离线自检（scripts/selftest_diagnostics.py）注入假模型，无需 key；
# 真实检查用 scripts/check_diagnosis_agent.py（未配置时退出码 2、零请求）。
# 【红线】诊断只读 + 建议：不修改笔记 / 选题 / 数据；不引入任何外部基准数字
#（行业均值 / 爆款阈值一律禁止，跨篇基准属第 18 步 RAG）；数据不足如实声明，
# 严重不足时 score 为 null。成本只存 token、不内置价格。
# 下列阈值为经验参考值、非平台官方口径，可按需调整。
# ---------------------------------------------------------------------------
# 提示词版本（写入 diagnostics.llm_meta.prompt_version，便于回溯）
DIAG_PROMPT_VERSION=v1
# 异常波动判定阈值：相邻快照中 views / likes 的降幅达到该比例才判 anomaly
DIAG_ANOMALY_DROP_RATIO=0.30
# 数据缺口收集时的快照条数下限（低于该值会在 data_gaps 中声明）
DIAG_MIN_SNAPSHOTS=1
# 四个文本数组（strengths / weaknesses / reasons / suggestions）条数上限
DIAG_MAX_LIST_ITEMS=8
# 四个文本数组单条最大字数（超出本地截断）
DIAG_TEXT_MAX_LEN=300
# score 合法区间（越界视为硬伤回炉；数据严重不足时必须为 null）
DIAG_SCORE_MIN=0
DIAG_SCORE_MAX=100

# ---------------------------------------------------------------------------
# 运营看板 + 周报（第 17 步 · 确定性看板在前 / LLM 周报在后）
#
# 看板（/api/v1/dashboard）：纯本地聚合（零 LLM、零网络），只读不改任何业务表。
# 周报（/api/v1/reports）：第五个业务图，走 harness 的
# get_chat_model(want_json=True)（OpenAI 兼容，指向 DeepSeek，温度 0.2）；
# 结论**不落业务表**，整体写入 agent_runs.outputs（run_type=weekly_report）。
# 真实调用受 AGENT_LLM_ENABLED / LLM_API_KEY 闸门约束：未开启时不发起任何请求。
# 离线自检（scripts/selftest_dashboard.py）注入假模型，无需 key；
# 真实检查用 scripts/check_weekly_report.py（未配置时退出码 2、零请求）。
# 【红线】周报只读 + 建议：不修改笔记 / 选题 / 数据；严禁编造外部行业数字
#（行业均值 / 爆款门槛一律禁止，跨篇基准属第 18 步 RAG）；数据不足必须写 data_gaps。
# 聚合口径全部为本地计算、非平台官方；成本只存 token、不内置价格。
# ---------------------------------------------------------------------------
# 提示词版本（写入周报 output.prompt_version，便于回溯）
WEEKLY_PROMPT_VERSION=v1
# 周报默认周期（近 N 天，含今天；跨度上限 90 天由代码校验）
WEEKLY_DEFAULT_DAYS=7
# 周报定时（默认 false = 不注册任何定时作业；true 时并入 app/main.py 唯一 lifespan）
WEEKLY_SCHEDULER_ENABLED=false
# 周报定时 cron（默认周一 09:00，本地时区 Asia/Shanghai；仅在上项为 true 时生效）
WEEKLY_SCHEDULE_CRON=0 9 * * 1
# 趋势图点数上限（区间过长时自动按等间隔收紧桶步长；经验参考值）
DASHBOARD_TREND_MAX_POINTS=30
# 排行默认返回条数
DASHBOARD_RANKING_TOP_N=10
# 看板默认时间窗口（近 N 个自然日）
DASHBOARD_DEFAULT_RANGE_DAYS=30

# ---------------------------------------------------------------------------
# RAG / embedding（第 18 步 · 本地 bge 向量化 + 爆款规律提炼 + 选题/创作反哺）
#
# 向量化（/api/v1/knowledge、规律提炼图、选题/创作反哺）：默认本地模型
# BAAI/bge-large-zh-v1.5（1024 维，与 knowledge_snippets.embedding 列一致 ⇒ 零迁移）。
# 首次真实向量化时才加载 / 下载模型（懒加载，不影响启动与健康检查）；
# 模型权重约 1.3GB，从 Hugging Face 拉取，国内可用镜像：
#     set HF_ENDPOINT=https://hf-mirror.com
# 依赖：langchain-huggingface、sentence-transformers（见 requirements.txt，
# 由用户本人安装；CPU 可跑，首次安装体积较大）。
#
# 规律提炼（第六个业务图，run_type=insights）：规律**只来自本账号本地数据**
# （自己的已发布笔记 + note_metrics + diagnostics），不爬竞品、不引入行业均值 /
# 爆款门槛等外部数字；样本不足（published 笔记数 < 门槛）不硬造规律，run 记 partial。
# 真实调用受 AGENT_LLM_ENABLED / LLM_API_KEY 闸门约束：未开启时不发起任何请求。
# 真实检查脚本：scripts/check_embedding_local.py（本地向量，不需 key）、
# scripts/check_insights_agent.py（真实 LLM，未配置时退出码 2、零请求）。
# 规律提炼定时：本步首版以**手动触发**为主（INSIGHTS_SCHEDULER_ENABLED 预留、未注册作业）。
# 【红线】RAG 反哺失败只 WARNING 降级、不阻断主流程；检索不返回向量与 llm_raw。
# ---------------------------------------------------------------------------
# embedding 提供方：local（默认）/ openai（占位，预留官方或第三方接口）
EMBEDDING_PROVIDER=local
# 本地模型名（须与 EMBEDDING_DIM 维度一致；可换 bge-m3 等 1024 维模型）
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# 向量维度（必须与数据库列 vector(1024) 一致；不一致会显式报错，需新建迁移——本步不做）
EMBEDDING_DIM=1024
# 推理设备：cpu（默认）/ cuda
EMBEDDING_DEVICE=cpu
# 批量向量化批大小
EMBEDDING_BATCH_SIZE=16
# 检索默认 top-k
EMBEDDING_TOP_K=5
# openai 兼容 embedding（仅 EMBEDDING_PROVIDER=openai 时生效；真实 key 只放本地 .env，
# 绝不写入代码 / 文档 / 日志；此处一律占位留空）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_OPENAI_MODEL=
# ---------------------------------------------------------------------------
# 检索策略（第 24 步 · 混合检索；默认 vector 与历史行为完全一致）
# vector = 纯 pgvector 余弦；hybrid = 向量 + pg_trgm 关键字两路，RRF 融合。
# hybrid 需要 pg_trgm 扩展（运行时幂等 CREATE EXTENSION；不可用时自动降级 vector）。
# 【不是 BM25】pg_trgm 只提供三元组相似度，没有 IDF 与词频饱和。
# ---------------------------------------------------------------------------
RAG_RETRIEVAL_MODE=vector
# 两路各自召回的候选池大小（融合前），应 ≥ 最终 top_k
RAG_HYBRID_POOL=20
# RRF 平滑常数（论文经验值 60）
RAG_RRF_K=60
# 提示词版本（写入知识块 meta.prompt_version，便于回溯）
INSIGHTS_PROMPT_VERSION=v1
# 样本门槛：published 笔记数低于该值不做提炼（不硬造规律）
INSIGHTS_MIN_PUBLISHED=3
# 单次提炼的规律条数上限 / 单条最大字数
INSIGHTS_PATTERN_MAX=15
INSIGHTS_TEXT_MAX_LEN=300
# 规律提炼定时开关（第 18 步首版手动触发为主，未注册定时作业；预留）
INSIGHTS_SCHEDULER_ENABLED=false
# RAG 反哺开关（默认开启；关闭后退化为「无 RAG」原链路，检索失败同样降级不阻断）
TOPIC_RAG_ENABLED=true
CONTENT_RAG_ENABLED=true

# ---- 第 25 步：选题图「LLM 自主选工具」（可选，默认关闭）----
# 打开后模型可在生成选题前调用只读工具（热点检索 / 知识检索 / 历史选题 / 人设细节）；
# 工具白名单写死，不暴露任何写操作。关闭时图与提示词与接入前完全一致。
# 评测结论（n=12 小样本）：工具召回 1.0、幻觉 0、收敛 1.0，但选择精确率仅 0.389、
# token 为基线的 5.8 倍、JSON 一次成功率无差异 → 默认保持 false（详见 docs/topic_tool_calling.md）。
TOPIC_TOOLCALLING_ENABLED=false
# 工具执行轮数硬上限（超过即收敛到生成节点）
TOPIC_TOOLCALLING_MAX_ROUNDS=3

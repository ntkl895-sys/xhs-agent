# ============================================================================
# xhs-agent · 本地基础设施配置（模板）
#
# 用法：复制本文件为同目录下的 .env 后按需修改：
#     copy .env.example .env        （Windows cmd）
#     Copy-Item .env.example .env   （PowerShell）
#
# ⚠️ 安全：
#   1. .env 已被 .gitignore 忽略，绝不会入库；
#   2. 下面这些账号密码【仅用于本机开发】，严禁用于任何生产 / 公网环境；
#   3. 真实密钥只填在 .env，切勿粘贴到对话、聊天记录或在线文档。
# ============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL（docker-compose.yml 的 db 服务）
# 说明：compose 首次创建数据卷时会用这里的值初始化数据库；之后修改此文件
#       不会改变已存在的数据库账号，如需重建请先 docker compose down -v。
# ---------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=xhs_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Redis（docker-compose.yml 的 redis 服务）
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# ---------------------------------------------------------------------------
# 大模型（DeepSeek，OpenAI 兼容接口）
#
# 模型 ID 一律使用占位符，请以 DeepSeek 控制台当前列表为准：
#   https://api-docs.deepseek.com/zh-cn/quick_start/pricing
#
# 后端实际生效的 LLM 配置在 backend/.env（本文件仅为根级基础设施配置）。
# 在填入真实 LLM_API_KEY 之前，请保持 backend/.env 的 AGENT_LLM_ENABLED=false：
#   —— 除显式的真实检查脚本（scripts/check_llm_harness.py）外，
#      任何入口都不会向 DeepSeek 或任何公网 LLM 发起请求。
# LangSmith 为可选 SaaS 观测平台，默认关闭；开启即意味着数据外发与费用自担。
# ---------------------------------------------------------------------------
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=把这里替换成DeepSeek控制台当前模型名
# 视觉模型（第 15 步 · 数据回填）：请在 backend/.env 的 LLM_VISION_MODEL 填写
# 【支持图片输入】的模型名（留空回退 LLM_MODEL）；本文件不重复此配置。

# ---------------------------------------------------------------------------
# 热搜采集（第 9 步 · DailyHotApi）
#
# docker compose 已含 dailyhot 服务（仅绑 127.0.0.1:6688），无需在此填写密钥。
# 后端实际生效的采集配置在 backend/.env（HOTSPOT_* 段）。
# 【合规红线】只采公开榜单，不请求任何小红书域名 / 不写登录态。
# ---------------------------------------------------------------------------
HOTSPOT_API_BASE_URL=http://127.0.0.1:6688

# ============================================================================
# xhs-agent · Git 忽略规则
# 原则：真实密钥（.env / .env.local）绝不入库；构建产物、依赖、数据卷全部忽略。
# ============================================================================

# --- 环境变量（真实密钥只放这里，example 只含占位符）---
.env
.env.local
.env.*.local

# --- 依赖 ---
**/node_modules/
**/.venv/
**/venv/
**/env/

# --- 构建产物 ---
**/.next/
**/out/
**/dist/
**/build/
**/.turbo/
**/.swc/

# --- Python ---
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- 日志 ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- 数据库数据卷 / 绑定目录（本项目用 named volume，此处为兜底）---
pgdata/
redis-data/
docker/data/

# --- 运维备份产物（pg_dump 含真实业务数据，绝不入库）---
backups/
*.dump
*.sql.gz

# --- 截图留档（第 15 步；默认 SAVE_SCREENSHOT=false 不落盘，开启后才产生）---
backend/data/screenshots/

# --- 系统与编辑器临时文件 ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.tmp
~$*
.idea/
.vscode/*
!.vscode/extensions.json
